  "project-memory-updater": {
    "description": "Project Memory Consolidator — 3-mode workflow (2A: Initial Build, 2B: Document Merge, 2C: Corrections Only) that maintains evolving project memory with conflict detection and clarification questions via LLM sub-workflow.",
    "uses_sub_workflows": [
      "llm-sub-workflow"
    ],
    "architecture": "3-step LLM pipeline (Extract → Merge → Questions) to avoid Bedrock timeouts",
    "nodes": [
      "1.1_TRG_Webhook (async — returns 200 immediately)",
      "1.2_VAL_Input (mode detection)",
      "1.3_IF_Valid",
      "1.4_IF_NeedStep1 (2A/2B vs 2C gate)",
      "2.1_FMT_Extract (Step 1 prompt)",
      "2.2_SUB_Extract (LLM call ~40s)",
      "2.3_FMT_MergeDoc (Step 2 prompt for doc path)",
      "2.4_FMT_MergeCorr (Step 2 prompt for corrections path)",
      "3.1_SUB_Merge (LLM call ~50s)",
      "3.2_FMT_Questions (Step 3 prompt + carry forward)",
      "3.3_SUB_Questions (LLM call ~25s)",
      "4.1_JS_Package (combine Step 2 memory + Step 3 questions)",
      "4.2_IF_Status",
      "4.3_API_Success (PUT to coreapi)",
      "5.1_ERR_Format",
      "5.2_API_Error (PUT to coreapi)"
    ],
    "development": {
      "n8nId": "o2dzZ5PxRIZfzNA0",
