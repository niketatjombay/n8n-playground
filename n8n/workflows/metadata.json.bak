{
  "sub_workflows": {
    "llm-sub-workflow": {
      "description": "Generic LLM utility — calls agentcoreapi (AWS Bedrock), parses JSON response with robust error handling. No workflow-specific logic.",
      "used_by": [
        "case-study-creator",
        "project-memory-updater",
        "document-summary-extractor"
      ],
      "api_endpoint": "https://agentcoreapi.jombay.com",
      "nodes": [
        "Start (trigger)",
        "HTTP Request (POST to agentcoreapi)",
        "Parse JSON Response (robust parser)"
      ],
      "input": {
        "prompt": "string — the full prompt to send to the LLM",
        "model": "string — Bedrock model ID (default: claude-haiku-4-5)",
        "node_name": "string — calling node name for error logging",
        "workflow_session_id": "string — session tracking ID",
        "workflow_id": "string — workflow identifier",
        "project_id": "string — project identifier",
        "client_id": "string — client identifier"
      },
      "output": {
        "llm_response": "object — parsed JSON from the LLM response"
      },
      "notes": "Generates runtimeSessionId >= 33 chars (AWS requirement). Retries 3x on failure. Handles markdown fences, prefixes, and malformed JSON.",
      "development": {
        "n8nId": "1DR7SBmbHnVajdbxTl5Vu",
        "project_id": "JIV2elLHsVFXybZ2",
        "folder_id": "b0ilmW1P95C76nj2"
      },
      "staging": {
        "n8nId": "GDaWNcJJtLdY8Q6Y4Yv5p",
        "project_id": "JIV2elLHsVFXybZ2",
        "folder_id": "6VQbrghLDVpWuwdv"
      },
      "production": {
        "n8nId": "TODO_PROD_LLM_ID",
        "project_id": "TODO_PROD_PROJECT_ID",
        "folder_id": "TODO_PROD_FOLDER_ID"
      }
    },
    "drive-utils": {
      "description": "Google Drive document extraction — fetches document content from a Google Drive URL and returns the extracted text.",
      "used_by": [
        "case-study-creator",
        "document-summary-extractor"
      ],
      "nodes": [
        "Start (trigger)",
        "Extract Document Content"
      ],
      "input": {
        "mode": "string — extraction mode (e.g. 'EXTRACT_CONTENT')",
        "google_drive_file_url": "string — full Google Drive/Docs URL"
      },
      "output": {
        "extracted_text": "string — plain text content of the document",
        "status": "string — 'success' or 'error'"
      },
      "development": {
        "n8nId": "1qoBroTFrN02UbZvJOBIJ",
