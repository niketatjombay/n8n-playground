      "data": "string — inline text content (for project_info or meeting_notes without URL)",
      "google_drive_url": "string — Google Drive URL (for meeting_notes/project_document with file)",
      "meeting_note_id": "string — meeting note identifier (for meeting_notes)",
      "project_document_id": "string — project document identifier (for project_document)"
